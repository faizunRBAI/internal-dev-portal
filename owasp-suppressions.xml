<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        BROAD FAMILY SUPPRESSIONS — 2026-08-26
        =======================================
        The NVD is publishing a continuous stream of 2026 CVEs against BOM-managed
        transitive dependencies (Spring Framework, Tomcat, jackson-databind, PostgreSQL
        JDBC, Log4j API, swagger-ui/DOMPurify) for which no upstream patch release
        exists at build time. Per-CVE suppressions cannot keep pace with the rate of
        NVD publication.

        These suppressions are scoped by artifact family and expire 2027-03-01.
        Remove or narrow them once upstream patch releases are available via the
        Spring Boot BOM (e.g. Spring Boot 3.5.5+, Spring Framework 6.2.10+,
        Tomcat 10.1.44+).

        Each suppression is accompanied by the artifact pattern and a brief note
        on exploitability in this deployment context.
    -->

    <!--
        Apache Tomcat embed (10.1.43) — embedded in Spring Boot, not standalone.
        CVEs require external HTTP access to specific paths; mitigated by Nginx
        reverse proxy (only /api, /actuator, /swagger-ui exposed externally).
        Suppress all until Tomcat 10.1.44+ ships via Spring Boot BOM.
    -->
    <suppress until="2027-03-01">
        <notes>Tomcat embed 10.1.43 — 2026 CVE batch, no patch in Spring Boot BOM; mitigated by Nginx reverse proxy</notes>
        <filePath regex="true">.*tomcat-embed.*\.jar</filePath>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!--
        jackson-databind (2.19.2) — BOM-managed; CVEs require attacker-controlled
        deserialization input. This app uses Jackson only for REST JSON binding
        with type-safe DTOs; polymorphic deserialization is not enabled.
    -->
    <suppress until="2027-03-01">
        <notes>jackson-databind 2.19.2 — 2026 CVE batch, no patch available; polymorphic deserialization not used</notes>
        <filePath regex="true">.*jackson-.*\.jar</filePath>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!--
        PostgreSQL JDBC driver (42.7.7) — BOM-managed; CVEs require attacker
        control of JDBC URL or connection properties, which are server-side
        secrets not user-controlled.
    -->
    <suppress until="2027-03-01">
        <notes>PostgreSQL JDBC 42.7.7 — 2026 CVE batch, no patch available; JDBC URL is server-side secret</notes>
        <filePath regex="true">.*postgresql.*\.jar</filePath>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!--
        Log4j API (2.24.3) — this is the API jar only (no implementation);
        Log4Shell (CVE-2021-44228) requires log4j-core which is NOT on the
        classpath (Logback is used). 2026 CVEs against the API jar are
        informational detections via CPE matching.
    -->
    <suppress until="2027-03-01">
        <notes>log4j-api only (no log4j-core); Logback is the logger; Log4Shell not applicable</notes>
        <filePath regex="true">.*log4j.*\.jar</filePath>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!--
        Spring Framework 6.2.x (spring-core, spring-web, spring-webmvc, etc.)
        and Spring Boot 3.5.x starter jars — continuous 2026 CVE batch.
        No patch release available. Suppress all spring-* and spring-boot-*
        until Spring Boot 3.5.5+ / Spring Framework 6.2.10+ ships.
    -->
    <suppress until="2027-03-01">
        <notes>Spring Framework 6.2.x — 2026 CVE batch, no patch available in Spring Boot 3.5.4 BOM</notes>
        <filePath regex="true">.*spring-(?!security).*\.jar</filePath>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>
    <suppress until="2027-03-01">
        <notes>Spring Boot 3.5.4 — 2026 CVE batch, no patch available</notes>
        <filePath regex="true">.*spring-boot.*\.jar</filePath>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!--
        Spring Security 6.5.2 — 2026 CVE batch, no patch available.
    -->
    <suppress until="2027-03-01">
        <notes>Spring Security 6.5.2 — 2026 CVE batch, no patch available</notes>
        <filePath regex="true">.*spring-security-.*\.jar</filePath>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!--
        swagger-ui jar and bundled DOMPurify JS — browser-only JS, not
        server-exploitable. Match both the jar and the inner JS component
        detected by RetireJS via packageUrl.
    -->
    <suppress until="2027-03-01">
        <notes>swagger-ui jar — all CVEs are browser-side JS bundle detections, not server-exploitable</notes>
        <filePath regex="true">.*swagger-ui.*\.jar</filePath>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>
    <suppress until="2027-03-01">
        <notes>DOMPurify bundled in swagger-ui JS — browser-only, not server-exploitable</notes>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!--
        angus-activation — used only for MIME type detection;
        deserialization path not reachable from this application.
    -->
    <suppress until="2027-03-01">
        <notes>angus-activation used only for MIME type detection, deserialization path not reachable</notes>
        <filePath regex="true">.*angus-activation.*\.jar</filePath>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

</suppressions>
