<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        swagger-ui JS bundles contain DOMPurify as a bundled JS dependency.
        CVEs affect browser-side DOM sanitization only — not server-exploitable.
        Match by packageUrl for the inner JS component detected by RetireJS.
    -->
    <suppress>
        <notes>DOMPurify bundled in swagger-ui — browser-only JS, not server-exploitable</notes>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>
    <!-- Also suppress by jar path for any jar-level detections -->
    <suppress>
        <notes>swagger-ui jar — all CVEs are browser-side JS bundle detections</notes>
        <filePath regex="true">.*swagger-ui.*\.jar</filePath>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

